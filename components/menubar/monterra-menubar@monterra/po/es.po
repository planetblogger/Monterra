msgid "Monterra Menu Bar"
msgstr "Barra de menús Monterra"

msgid "Classic menu bar: the Monterra logo opens the system menu, followed by one drop-down menu per app category. Opens on hover, Super opens app search."
msgstr "Barra de menús clásica: el logotipo de Monterra abre el menú del sistema, seguido de un menú desplegable por cada categoría de aplicaciones. Se abre al pasar el ratón; la tecla Súper abre la búsqueda."

msgid "Behaviour"
msgstr "Comportamiento"

msgid "Open menus when the mouse pointer rests on them"
msgstr "Abrir los menús al dejar el puntero sobre ellos"

msgid "Delay before a menu opens"
msgstr "Retardo antes de abrir un menú"

msgid "ms"
msgstr "ms"

msgid "Close the menu when the mouse pointer leaves it"
msgstr "Cerrar el menú cuando el puntero salga de él"

msgid "Keyboard shortcut to open the Monterra menu and search"
msgstr "Atajo de teclado para abrir el menú Monterra y la búsqueda"

msgid "Content"
msgstr "Contenido"

msgid "App search in the Monterra menu"
msgstr "Búsqueda de aplicaciones en el menú Monterra"

msgid "Show app icons in the menus"
msgstr "Mostrar iconos de aplicaciones en los menús"

msgid "Show “Administration” and “Preferences” in the menu bar (otherwise in the Monterra menu)"
msgstr "Mostrar «Administración» y «Preferencias» en la barra de menús (si no, en el menú Monterra)"

msgid "Open"
msgstr "Abrir"

msgid "Add to Dock"
msgstr "Añadir al dock"

msgid "Remove from Dock"
msgstr "Quitar del dock"

msgid "Add to Favorites"
msgstr "Añadir a favoritos"

msgid "Remove from Favorites"
msgstr "Quitar de favoritos"

msgid "Properties…"
msgstr "Propiedades…"



