{
  "head-look": {
    "type": "header",
    "description": "Appearance"
  },
  "icon-size": {
    "type": "spinbutton",
    "default": 48,
    "min": 24,
    "max": 96,
    "step": 2,
    "units": "px",
    "description": "Icon size"
  },
  "magnify": {
    "type": "switch",
    "default": true,
    "description": "Magnify icons on hover"
  },
  "magnify-size": {
    "type": "spinbutton",
    "default": 76,
    "min": 32,
    "max": 128,
    "step": 2,
    "units": "px",
    "description": "Magnified size",
    "dependency": "magnify"
  },
  "style": {
    "type": "combobox",
    "default": "auto",
    "description": "Style",
    "options": {
      "Automatic (follows Cinnamon theme)": "auto",
      "Light": "light",
      "Dark": "dark"
    }
  },
  "head-behaviour": {
    "type": "header",
    "description": "Behaviour"
  },
  "autohide": {
    "type": "switch",
    "default": false,
    "description": "Hide automatically when a window covers the dock"
  },
  "click-minimize": {
    "type": "switch",
    "default": true,
    "description": "Clicking the active app minimises it"
  },
  "show-running": {
    "type": "switch",
    "default": true,
    "description": "Show running apps that are not pinned"
  },
  "show-trash": {
    "type": "switch",
    "default": true,
    "description": "Show trash"
  },
  "head-separators": {
    "type": "header",
    "description": "Separators"
  },
  "separators-help": {
    "type": "label",
    "description": "Separators between pinned apps: right-click an app → “Insert Separator Left/Right”. Move them by drag and drop, remove them by right-clicking the separator."
  },
  "separators": {
    "type": "generic",
    "default": []
  }
}
